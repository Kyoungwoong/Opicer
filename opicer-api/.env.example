# Copy to .env (never commit .env) and fill in what you need; empty keys use the defaults in application.yaml.
# Loaded by run-local.sh (macOS/Linux/WSL) or run-local.ps1 (Windows).

# Database (defaults match docker-compose.yml: localhost:5432/opicer, user opicer)
OPICER_DB_URL=
OPICER_DB_USER=
OPICER_DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_TTL_SECONDS=
JWT_COOKIE_SECURE=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
ADMIN_EMAIL_ALLOWLIST=
FRONTEND_BASE_URL=

# OpenAI (speech to text and evaluation)
OPENAI_API_KEY=
# mock (default, canned transcripts) or openai (Whisper)
OPICER_STT_PROVIDER=
OPICER_STT_OPENAI_MODEL=
OPICER_EVAL_PROVIDER=
OPICER_EVAL_MODEL=
OPICER_EVAL_REASONING_EFFORT=
OPICER_EVAL_MAX_OUTPUT_TOKENS=
OPICER_EVAL_TIMEOUT_SECONDS=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSION=

# Background evaluation worker
OPICER_AI_WORKER_ENABLED=
OPICER_AI_WORKER_POLL_MS=
OPICER_AI_WORKER_CONCURRENCY=

# NAVER Cloud Platform Maps (geocoding for test centers)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
